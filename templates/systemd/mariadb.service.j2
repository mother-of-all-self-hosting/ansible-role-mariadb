[Unit]
Description=MariaDB ({{ mariadb_identifier }})
{% for service in mariadb_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in mariadb_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ mariadb_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name {{ mariadb_identifier }} \
      --log-driver=none \
      --user={{ mariadb_uid }}:{{ mariadb_gid }} \
      --network={{ mariadb_container_network }} \
      {% if mariadb_container_mariadb_bind_port %}
      -p {{ mariadb_container_mariadb_bind_port }}:{{ mariadb_connection_port }} \
      {% endif %}
      --env-file={{ mariadb_base_path }}/env \
      --mount type=bind,src={{ mariadb_data_path }},dst=/var/lib/mysql \
      --mount type=bind,src={{ mariadb_base_path }}/my.cnf,dst=/root/.my.cnf,ro \
      {% if mariadb_container_unix_socket_enabled %}
      --mount type=bind,src={{ mariadb_run_path }},dst={{ mariadb_run_path_in_container }} \
      {% endif %}
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ mariadb_container_tmpfs_tmp_size }} \
      {% for arg in mariadb_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ mariadb_container_image_to_use }} \
      {% for arg in mariadb_process_extra_arguments %}
      {{ arg }} \
      {% endfor %}

{% for network in mariadb_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ mariadb_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ mariadb_identifier }}

{% if mariadb_systemd_readiness_check_enabled %}
# Only count the service as started once MariaDB accepts connections. Otherwise, services ordered
# after this one (`After=`) get started while MariaDB is still initializing, and those that set up
# their database only once at startup end up running against an empty one.
#
# Why TCP and not the Unix socket: when the data directory is empty, the image's entrypoint first
# initializes it through a temporary server, which does listen on the Unix socket but runs with
# `--skip-networking`. That server is then shut down and replaced by the real one. A ping over the
# socket would already succeed against the temporary server; one over TCP only succeeds once the
# real server is up.
#
# `ping` succeeds even when access is denied, so no credentials are needed.
#
# The `-` prefix makes a timeout non-fatal: the service then counts as started, as it did before this
# check existed. A setup where MariaDB does not listen on TCP is thus delayed, but not broken.
ExecStartPost=-{{ devture_systemd_docker_base_host_command_sh }} -c 'timeout {{ mariadb_systemd_readiness_check_timeout_seconds }} {{ devture_systemd_docker_base_host_command_sh }} -c "until {{ devture_systemd_docker_base_host_command_docker }} exec {{ mariadb_identifier }} mariadb-admin --protocol=tcp --host=127.0.0.1 --port={{ mariadb_connection_port }} ping >/dev/null 2>&1; do sleep 1; done"'
TimeoutStartSec={{ mariadb_systemd_readiness_check_timeout_seconds | int + 120 }}
{% endif %}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ mariadb_container_stop_grace_time_seconds }} {{ mariadb_identifier }} 2>/dev/null'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ mariadb_identifier }} 2>/dev/null'
Restart=always
RestartSec=30
SyslogIdentifier={{ mariadb_identifier }}

[Install]
WantedBy=multi-user.target
