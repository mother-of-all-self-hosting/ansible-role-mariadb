if [ $# -ne 1 ]; then
    echo "Usage: "$0" <directory_path>"
    echo "A latest-dump.sql.zst file will be dumped to the specified directory"
    exit 1
fi

directory_path=$1

if [ ! -d "$directory_path" ]; then
    echo "$directory_path does not exist."
    exit 1
fi

# The dump holds every database (including password hashes), so only the caller may read it.
umask 077

dump_path="$directory_path/latest-dump.sql.zst"

# Runs the dump inside the (running) MariaDB container, connecting over TCP to 127.0.0.1 (like the managed databases preparation does),
# and streams the compressed dump out. The root password comes from the container's own environment
# (`MARIADB_ROOT_PASSWORD`, see the `env` file) and is handed to the client via `MYSQL_PWD`, so that it does not appear on any command line.
#
# The dump goes to a temporary file first, so that a failed dump neither leaves a truncated dump behind
# (which could be mistaken for a good one) nor destroys the previous dump.
{{ devture_systemd_docker_base_host_command_docker }} exec \
    {{ mariadb_identifier }} \
    bash -c 'set -o pipefail && export MYSQL_PWD="$MARIADB_ROOT_PASSWORD" && {{ mariadb_binary_name_dump }} --user=root --protocol=tcp --host=127.0.0.1 --port={{ mariadb_connection_port }} --all-databases | zstd --stdout' \
    > "$dump_path.partial"
status=$?

if [ $status -ne 0 ]; then
    rm -f "$dump_path.partial"
    echo "Dumping failed (exit code $status)." >&2
    exit $status
fi

mv "$dump_path.partial" "$dump_path"
