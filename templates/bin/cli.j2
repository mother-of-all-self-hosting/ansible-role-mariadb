# Runs the client inside the (running) MariaDB container, connecting via the Unix socket (if `mariadb_cli_use_unix_socket_enabled`)
# or over TCP to 127.0.0.1 (like the managed databases preparation does).
# The root password comes from the container's own environment (`MARIADB_ROOT_PASSWORD`, see the `env` file)
# and is handed to the client via `MYSQL_PWD`, so that it does not appear on any command line.
# A TTY is only requested when there is one, so that SQL can also be piped in (e.g. `echo 'SELECT 1' | cli`).
docker_exec_args=(-i)
if [ -t 0 ]; then
    docker_exec_args+=(-t)
fi

exec {{ devture_systemd_docker_base_host_command_docker }} exec \
    "${docker_exec_args[@]}" \
    {{ mariadb_identifier }} \
    sh -c 'export MYSQL_PWD="$MARIADB_ROOT_PASSWORD" && exec "$@"' sh \
    {{ mariadb_binary_name_shell }} \
    --user=root \
    {% if mariadb_cli_use_unix_socket_enabled %}
    --socket={{ mariadb_run_path_in_container }}/mysqld.sock \
    {% else %}
    --protocol=tcp \
    --host=127.0.0.1 \
    --port={{ mariadb_connection_port }} \
    {% endif %}
    {{ mariadb_db_name }} \
    "$@"
