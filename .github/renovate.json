{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mother-of-all-self-hosting/renovate-config#v1.1.0",
    "github>mother-of-all-self-hosting/renovate-config//patch-automerge#v1.1.0"
  ],
  "separateMinorPatch": true,
  "packageRules": [
    {
      "description": "A new MariaDB major or minor becomes a new variable, never a bump of an old one",
      "matchPackageNames": ["/mariadb/"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/defaults/main.yml$/"
      ],
      "matchStrings": [
        "mariadb_container_image_v\\d+_\\d+:\\s*\"[^\"]*mariadb:(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "mariadb",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ]
}
